# ─────────────────────────────────────────
# .gitignore — Academic Research Summarizer
# ─────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# Environment files – NEVER commit secrets
.env
backend/.env
frontend/.env
frontend/.env.local

# Uploaded research papers (user data)
storage/*
!storage/.gitkeep

# Node
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Logs
*.log
logs/

# MongoDB data directory
data/db/

# NLP model caches
*.pkl
*.bin
*.pt
*.onnx
models/
.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml
test-results/

# Evaluation datasets (add to LFS or document separately)
evaluation/dataset/*.pdf
evaluation/results/*.json
