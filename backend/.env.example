# ─────────────────────────────────────────────
# Backend Environment Configuration Template
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# MongoDB connection URI
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=academic_research_db

# JWT Secret – replace with a long random string in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File storage path (relative to backend root, or absolute)
STORAGE_DIR=../../storage

# Max upload size in bytes (default 20 MB)
MAX_UPLOAD_SIZE=20971520

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application environment: development | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
